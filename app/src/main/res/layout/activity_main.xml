<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back"
    tools:context=".MainActivity">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/statusLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.15"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/view_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.41"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <LinearLayout
            android:id="@+id/rt_linearlayout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toEndOf="@+id/view_left"
            app:layout_constraintWidth_percent="0.59"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/inside_linearlayout"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:paddingEnd="40dp">
                <View
                    android:layout_width="0dp"
                    android:layout_weight="5"
                    android:layout_height="match_parent"/>
                <ImageView
                    android:id="@+id/im_wifi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="@dimen/index_icon_padding"
                    android:paddingStart="@dimen/index_icon_padding"
                    android:paddingEnd="@dimen/index_icon_padding"
                    android:src="@drawable/icon_wifi" />
                <ImageView
                    android:id="@+id/im_ble"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="@dimen/index_icon_padding"
                    android:paddingStart="@dimen/index_icon_padding"
                    android:paddingEnd="@dimen/index_icon_padding"
                    android:src="@drawable/icon_ble"/>
                <ImageView
                    android:id="@+id/im_usb"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="@dimen/index_icon_padding"
                    android:paddingStart="@dimen/index_icon_padding"
                    android:paddingEnd="@dimen/index_icon_padding"
                    android:src="@drawable/icon_usb1" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/statusLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.12"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tv_time"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="13:16"
            android:textColor="@color/black"
            android:textSize="@dimen/tvDay_textSize"
            android:gravity="center_vertical|center_horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_day"
            app:layout_constraintWidth_percent="0.18"
            android:autoSizeTextType="uniform"
            android:layout_marginEnd="10dp"
            android:layout_marginStart="40dp"
            android:fontFamily="@font/yupearl_extralight"/>

        <TextView
            android:id="@+id/tv_day"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center_vertical"
            android:text="周六\n2023/12/11"
            android:textColor="@color/black"
            android:textSize="@dimen/tvTime_textSize"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_time"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0"
            app:layout_constraintWidth_percent="0.2"
            android:fontFamily="@font/qingniao"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/topLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="horizontal"
        android:paddingStart="@dimen/index_padding"
        android:paddingEnd="@dimen/index_padding">

        <ImageView
            android:id="@+id/im_netflix"
            android:layout_width="@dimen/index_bigicon_width"
            android:layout_height="@dimen/index_bigicon_height"
            android:layout_marginTop="@dimen/index_bigicon_marginTop"
            android:layout_marginStart="@dimen/index_netflix_marginStart"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:scaleType="fitXY"
            android:src="@drawable/icon_netflix"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <ImageView
            android:id="@+id/im_youtube"
            android:layout_width="@dimen/index_bigicon_width"
            android:layout_height="@dimen/index_bigicon_height"
            android:layout_marginTop="@dimen/index_bigicon_marginTop"
            android:layout_marginStart="@dimen/index_bigicon_marginStart"
            app:layout_constraintStart_toEndOf="@+id/im_netflix"
            app:layout_constraintTop_toTopOf="parent"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:scaleType="fitXY"
            android:src="@drawable/icon_youtube"/>
        <ImageView
            android:id="@+id/im_prime"
            android:layout_width="@dimen/index_bigicon_width"
            android:layout_height="@dimen/index_bigicon_height"
            android:layout_marginTop="@dimen/index_bigicon_marginTop"
            android:layout_marginStart="@dimen/index_bigicon_marginStart"
            app:layout_constraintStart_toEndOf="@+id/im_youtube"
            app:layout_constraintTop_toTopOf="parent"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:scaleType="fitXY"
            android:src="@drawable/icon_prime"/>
        <ImageView
            android:id="@+id/im_castting"
            android:layout_width="@dimen/index_small_width"
            android:layout_height="@dimen/index_small_height"
            android:layout_marginTop="@dimen/index_small_tv_marginTop"
            android:layout_marginStart="@dimen/index_bigicon_marginStart"
            app:layout_constraintStart_toEndOf="@+id/im_prime"
            app:layout_constraintTop_toTopOf="parent"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:scaleType="centerCrop"
            android:src="@drawable/icon_casting"/>
        <ImageView
            android:id="@+id/im_appstore"
            android:layout_width="@dimen/index_small_width"
            android:layout_height="@dimen/index_small_height"
            android:layout_marginTop="@dimen/index_small_tv_marginTop"
            android:layout_marginStart="@dimen/index_bigicon_marginStart"
            app:layout_constraintStart_toEndOf="@+id/im_castting"
            app:layout_constraintTop_toTopOf="parent"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:scaleType="centerCrop"
            android:src="@drawable/icon_appstore"/>
        <ImageView
            android:id="@+id/im_settings"
            android:layout_width="@dimen/index_small_width"
            android:layout_height="@dimen/index_small_height"
            android:layout_marginTop="@dimen/index_small_marginTop"
            android:layout_marginStart="@dimen/index_bigicon_marginStart"
            app:layout_constraintStart_toEndOf="@+id/im_prime"
            app:layout_constraintTop_toBottomOf="@+id/im_castting"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:scaleType="centerCrop"
            android:src="@drawable/icon_settings"/>
        <ImageView
            android:id="@+id/im_applications"
            android:layout_width="@dimen/index_small_width"
            android:layout_height="@dimen/index_small_height"
            android:layout_marginTop="@dimen/index_small_marginTop"
            android:layout_marginStart="@dimen/index_bigicon_marginStart"
            app:layout_constraintStart_toEndOf="@+id/im_settings"
            app:layout_constraintTop_toBottomOf="@+id/im_appstore"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:scaleType="centerCrop"
            android:src="@drawable/icon_applications"/>
        <GridView
            android:id="@+id/heat_set"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/index_hit_height"
            app:layout_constraintTop_toBottomOf="@+id/im_netflix"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:descendantFocusability="afterDescendants"
            android:gravity="center"
            android:horizontalSpacing="0dp"
            android:numColumns="8"
            android:paddingTop="@dimen/index_heat_paddingTop"
            android:stretchMode="columnWidth"
            android:layout_marginStart="@dimen/index_margin"
            android:layout_marginEnd="@dimen/index_margin"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>